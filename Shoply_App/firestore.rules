rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }
    match /Categories/{category} {
      allow read: if true;
      allow write: if isAdmin();
      match /products/{product} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }
    match /{path=**}/products/{product} {
      allow read: if true;
    }
    match /Sales/{sale} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /User/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
      match /{document=**} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }
    match /Order/{order} {
      allow create: if signedIn() && request.resource.data.userUid == request.auth.uid;
      allow read: if isAdmin() || (signedIn() && resource.data.userUid == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if false;
    }
  }
}
